<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>Shoko.ImagePlanner</AssemblyName>
    <RootNamespace>Shoko.ImagePlanner</RootNamespace>
    <!-- Release packaging supplies these properties explicitly. These values
         keep local no-tag builds usable without deriving a version from git. -->
    <Version>1.0.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">Stable</ReleaseChannel>
    <PackageId>Shoko.ImagePlanner</PackageId>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Authors>Shoko Image Planner contributors</Authors>
    <!--
      Repository identity is resolved from the git remote / CI so forks and
      local builds embed the correct URL. CI passes -p:RepositoryUrl so
      nothing here hardcodes the canonical owner. Keep the default in sync
      with build/package.sh for builds that do not provide either.
    -->
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/crowquillx/shoko-image-manager</RepositoryUrl>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">$(RepositoryUrl)</PackageProjectUrl>
    <PackageTags>shoko,plugin,images,metadata</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Shoko.Abstractions" Version="6.0.0-alpha.77" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Ui/image-planner.html" LogicalName="Shoko.ImagePlanner.Ui.image-planner.html" />
    <EmbeddedResource Include="Ui/image-planner.css" LogicalName="Shoko.ImagePlanner.Ui.image-planner.css" />
    <EmbeddedResource Include="Ui/image-planner.js" LogicalName="Shoko.ImagePlanner.Ui.image-planner.js" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="PackageID" Value="7c5f8f4d-7b1d-4e07-9d4c-5d8bd6f581a2" />
    <AssemblyMetadata Include="PackageName" Value="Shoko Image Planner" />
    <AssemblyMetadata Include="PackageOverview" Value="Assign distinct images to series within each top-level Shoko group." />
    <AssemblyMetadata Include="PackageTags" Value="shoko,plugin,images,metadata" />
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
    <AssemblyMetadata Include="PackageProjectUrl" Value="$(PackageProjectUrl)" />
    <AssemblyMetadata Include="RuntimeIdentifier" Value="any" />
    <AssemblyMetadata Include="ReleaseChannel" Value="$(ReleaseChannel)" />
  </ItemGroup>
</Project>
